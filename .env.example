# Copy to .env and fill in only the providers you use. .env is git-ignored.
# Keep comments on their own lines: text after KEY= is read as the value.

# card audio: ElevenLabs voices (elevenlabs.io), Azure speech as the alternative
ELEVENLABS_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# image generation (gpt-image) and, later, speech-to-text cross-checks
OPENAI_API_KEY=
# free photo search (picture chain): pexels.com/api and pixabay.com/api/docs
PEXELS_API_KEY=
PIXABAY_API_KEY=
# image generation alternatives
RECRAFT_API_KEY=
GEMINI_API_KEY=
# card writing + verification
ANTHROPIC_API_KEY=
# CAMeL Tools in its own environment (it pulls in torch): that environment's python, and its data folder
PANKO_CAMEL_PYTHON=
CAMELTOOLS_DATA=
