# Copy to deploy/.env on the server (git-ignored) and fill in. Read by Compose for the front door and Caddy.

# your DuckDNS name (later your own domain), and the address invite links use
PANKO_DOMAIN=yourname.duckdns.org
PANKO_HOST_URL=https://yourname.duckdns.org

# per user: disk quota (GB), largest upload (MB); minutes before an idle user's Panko is stopped
PANKO_QUOTA_GB=5
PANKO_UPLOAD_MB=500
PANKO_IDLE_MINUTES=20

# optional: the server's own free photo-site keys, used by everyone who hasn't added theirs
PANKO_DEFAULT_PEXELS_API_KEY=
PANKO_DEFAULT_PIXABAY_API_KEY=
